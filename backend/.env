# ─── Client ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── GitHub commit-feed poller (optional) ────────────────────
# Personal Access Token (classic or fine-grained, read-only on repos) used by
# the commit-feed cron. Public repos work without one but are limited to
# 60 requests/hour per IP; setting this raises the limit to 5,000/hour and
# also grants access to any private repo the token can read.
# Leave blank to keep the poller running against public repos only.
GITHUB_TOKEN=
# Optional override for the cron schedule (standard 5-field cron). Default:
# '*/10 * * * *' (every 10 minutes). Useful in dev to drop to '* * * * *'.
GITHUB_POLL_CRON=


# ─── AI Tutor (Google Gemini Flash — free tier) ──────────────
# Get a key at https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day, 1M tokens/min
GEMINI_API_KEY=AQ.Ab8RN6JK9OQ9XCflUoEVxLM9NTCGffIe3fJWTjJow8GvQOgo9g
AI_TUTOR_DAILY_LIMIT=30

# ─── WhatsApp Cloud API (Meta) — optional ────────────────────
# Free tier: 1,000 service conversations/month
# Setup: https://developers.facebook.com/apps → WhatsApp → API Setup
# Leaving these blank disables WhatsApp notifications gracefully.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=


# ─── OAuth: Google ───────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# The same Client ID is used by the frontend (VITE_GOOGLE_CLIENT_ID) and the
# backend (to verify the token's audience). Apps using @react-oauth/google
# expect a "Web application" client type with the dev origin authorized.
GOOGLE_CLIENT_ID=

# ─── OAuth: Apple ────────────────────────────────────────────
# Apple Developer → Certificates, Identifiers & Profiles → Identifiers
# Create a "Services ID" (NOT an App ID) — its identifier (reverse-DNS, e.g.
# com.ebringgs.web) is your APPLE_CLIENT_ID. The same value goes into the
# frontend as VITE_APPLE_CLIENT_ID. Apple's token verification only needs the
# Client ID — the Team ID + Key + Private Key (.p8) are only required if you
# call Apple's token endpoint server-side (you don't in the JS SDK flow).
APPLE_CLIENT_ID=

# ─── Admin Seed (used by `npm run seed:admin`) ───────────────
ADMIN_NAME=Emmanuel Ebri
