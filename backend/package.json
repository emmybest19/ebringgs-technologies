{
  "name": "e-bringgs-backend",
  "version": "1.0.0",
  "description": "E-Bringgs Technologies Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,json --exec \"ts-node src/index.ts\"",
    "dev:staging": "cross-env NODE_ENV=staging nodemon --watch src --ext ts,json --exec \"ts-node src/index.ts\"",
    "dev:prod": "cross-env NODE_ENV=production nodemon --watch src --ext ts,json --exec \"ts-node src/index.ts\"",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "cross-env NODE_ENV=development ts-node src/scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.14",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
