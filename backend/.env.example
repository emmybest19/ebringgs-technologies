# ─── Environment ─────────────────────────────────────────────
# One of: development | staging | production
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────
# The app picks the URI based on NODE_ENV.
# Provide the full Atlas connection string for each environment.
MONGO_URI_DEVELOPMENT=mongodb+srv://ebringgs-dev:L6T2sWm6QibXa6ut@ebringgs-development.lggozd7.mongodb.net/?appName=ebringgs-development
MONGO_URI_STAGING=mongodb+srv://ebringgs-staging:Zn7lV9ja0zk7ygbX@ebringgs-staging.1e33qob.mongodb.net/?appName=ebringgs-staging
MONGO_URI_PRODUCTION=mongodb+srv://blingg-app-prod:iGbjCFTla2jkKS89@blingg-prod-cluster.nt2wrre.mongodb.net/?appName=blingg-prod-cluster

# Optional fallback (used only if the env-specific URI above is missing)
MONGO_URI=mongodb://localhost:27017/ebringgs

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Nodemailer) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ebringgstechnologies@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=E-Bringgs <ebringgstechnologies@gmail.com>

# ─── Paystack ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...

# ─── Push Notifications (VAPID) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:ebringgstechnologies@gmail.com

# ─── Client ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI Tutor (Google Gemini Flash — free tier) ──────────────
# Get a key at https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day, 1M tokens/min
GEMINI_API_KEY=
AI_TUTOR_DAILY_LIMIT=30

# ─── WhatsApp Cloud API (Meta) — optional ────────────────────
# Free tier: 1,000 service conversations/month
# Setup: https://developers.facebook.com/apps → WhatsApp → API Setup
# Leaving these blank disables WhatsApp notifications gracefully.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Admin Seed (used by `npm run seed:admin`) ───────────────
ADMIN_NAME=Administrator
ADMIN_EMAIL=ebringgstechnologies@gmail.com
ADMIN_PASSWORD=change_me_to_a_strong_password
